{
  "name": "ai-usage-tracker",
  "version": "0.1.0",
  "description": "Multi-account desktop widget AI usage tracker for Claude Code, Antigravity, Gemini, and Codex",
  "license": "MIT",
  "author": "Yodharin monplub <yodharinmonlub@actuarialtutor.org>",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:icons && npm run build:main && npm run build:renderer",
    "start": "node scripts/launch-electron.mjs",
    "smoke": "node scripts/launch-electron.mjs --smoke",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:win": "npm run build && electron-builder --win --dir",
    "package:exe": "npm run build && electron-builder --win portable nsis --x64"
  },
  "build": {
    "appId": "org.actuarialtutor.ai-tracker",
    "productName": "AI Tracker",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "assets/**",
      "dist-electron/sql-wasm.wasm"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "!dist-electron/*.map",
      "!node_modules/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AI-Tracker-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AI-Tracker-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
